{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NekoFM",
  "version": "0.1.0",
  "identifier": "fm.neko.NekoFM",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "NekoFM",
        "width": 1280,
        "height": 860,
        "minWidth": 720,
        "minHeight": 760,
        "maxWidth": 1440
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": [
            "$HOME/**",
            "$APPDATA/**",
            "$APPCONFIG/**"
          ]
        }
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
